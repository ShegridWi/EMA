# Copy this file to .env and fill in real values. Never commit .env itself.

# Points at the local docker-compose "db" service by default.
DATABASE_URL="postgresql://ema:ema_dev_password@localhost:5432/ema?schema=public"

# Auth.js (NextAuth) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Transactional email (see .claude/docs/04-scope-mvp.md for the open
# assumption on which address(es) receive the weekly report)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Shared secret checked by app/api/cron/weekly-report to reject
# unauthenticated calls — generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""
