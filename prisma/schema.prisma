// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SELLER
}

enum City {
  LA_PAZ
  SANTA_CRUZ
}

enum Theme {
  LIGHT
  DARK
}

enum Locale {
  ES
  EN
}

enum Unit {
  METERS
  UNITS
  ROLLS
}

enum ProductKind {
  UNIT
  SET
}

enum PieceRole {
  TOP
  BOTTOM
  CAP
}

// Fixed size catalog (confirmed with the business, see 04-scope-mvp.md #6).
enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

enum SaleType {
  CASH
  ORDER
  RESERVATION
}

enum PaymentMethod {
  QR
  CASH
}

// Phase 9 — dedicated per-product stock ledger, not derived from
// MovementLog (see 02-data-model.md "ProductStockMovement" for why: a
// SALE already writes a MovementLog row scoped to the Sale entity, not
// the Product, so reusing that table for a per-product view would mean
// a duplicate log per sale or inferring before/after quantities from
// free-form metadata).
enum StockMovementReason {
  CREATED
  MANUAL_ADJUSTMENT
  SALE
  RETURN
  VOID
}

// Append-only log actions. Extend this enum as new mutating actions are
// added; never repurpose an existing value (breaks historical entries).
enum MovementAction {
  LOGIN
  CREATE_MATERIAL
  UPDATE_MATERIAL
  DELETE_MATERIAL
  DEACTIVATE_MATERIAL
  REACTIVATE_MATERIAL
  CREATE_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  DEACTIVATE_PRODUCT
  REACTIVATE_PRODUCT
  CREATE_SALE
  UPDATE_SALE
  DELETE_SALE
  RETURN_SALE
  VOID_SALE
  CREATE_USER
  UPDATE_USER
  DELETE_USER
  REACTIVATE_USER
  UPDATE_SETTINGS
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role
  city         City
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  materials              Material[]
  products               Product[]
  sales                  Sale[]
  movementLogs           MovementLog[]
  settings               UserSettings?
  stockMovements         ProductStockMovement[]
  materialStockMovements MaterialStockMovement[]
}

// Per-user preferences (phase 9) — created on demand with defaults the
// first time they're read (see getOrCreateUserSettings in
// lib/user-settings.ts), not required at signup, so existing users from
// before this phase don't need a data migration.
model UserSettings {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  // IANA identifier (e.g. "America/La_Paz") — not an enum, the picker
  // uses Intl.supportedValuesOf("timeZone") instead of a hand-maintained
  // list (05-nextjs-conventions.md "Timezone handling").
  timezone  String   @default("America/La_Paz")
  theme     Theme    @default(LIGHT)
  locale    Locale   @default(ES)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Material {
  id            String    @id @default(uuid())
  // materialType/color: free text for now, see 04-scope-mvp.md #5
  // (pending confirmation on an admin-editable catalog).
  materialType  String
  color         String?
  type          String
  quantity      Decimal   @db.Decimal(10, 2)
  unit          Unit
  city          City
  purchasePrice Decimal   @db.Decimal(10, 2)
  // Reversible toggle (phase 9), separate from deletedAt below — same
  // pattern as Product.active (02-data-model.md).
  active        Boolean   @default(true)
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  stockMovements MaterialStockMovement[]
}

// Per-material stock ledger, same idea and same StockMovementReason enum
// as ProductStockMovement (02-data-model.md) — but simpler: quantities
// are Decimal here (Material.quantity is Decimal(10,2), unlike
// Product.quantity's Int — a material's stock can be fractional, e.g.
// 5.25 meters of fabric), and there's no saleId — materials aren't sold
// directly, only SALE/RETURN/VOID never apply here (createMaterial only
// ever writes CREATED, updateMaterial only ever writes
// MANUAL_ADJUSTMENT).
model MaterialStockMovement {
  id             String              @id @default(uuid())
  materialId     String
  material       Material            @relation(fields: [materialId], references: [id])
  quantityBefore Decimal             @db.Decimal(10, 2)
  quantityAfter  Decimal             @db.Decimal(10, 2)
  delta          Decimal             @db.Decimal(10, 2)
  reason         StockMovementReason
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  createdAt      DateTime            @default(now())
}

model Product {
  id          String      @id @default(uuid())
  kind        ProductKind
  description String
  color       String
  size        Size
  quantity    Int
  price       Decimal     @db.Decimal(10, 2)
  city        City
  setId       String?
  set         Product?    @relation("ProductPieces", fields: [setId], references: [id])
  pieces      Product[]   @relation("ProductPieces")
  pieceRole   PieceRole?
  // Reversible toggle (phase 9), separate from deletedAt below — e.g.
  // discontinued/out of production but might come back. Doesn't cascade
  // to a SET's pieces, same independent-row rule as delete
  // (02-data-model.md).
  active      Boolean     @default(true)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  sales          Sale[]
  stockMovements ProductStockMovement[]
}

model Sale {
  id            String        @id @default(uuid())
  productId     String
  product       Product       @relation(fields: [productId], references: [id])
  kind          ProductKind
  description   String
  color         String
  size          Size
  quantity      Int
  unitPrice     Decimal       @db.Decimal(10, 2)
  totalPrice    Decimal       @db.Decimal(10, 2)
  city          City
  saleDate      DateTime
  saleType      SaleType
  paymentMethod PaymentMethod
  amountPaid    Decimal       @db.Decimal(10, 2)
  balanceDue    Decimal       @db.Decimal(10, 2)
  deliveryDate  DateTime?
  sellerId      String
  seller        User          @relation(fields: [sellerId], references: [id])
  customerName  String?
  customerPhone String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  stockMovements ProductStockMovement[]
}

// Phase 9 — see the StockMovementReason enum above for why this is a
// dedicated table rather than filtered MovementLog entries. Every
// function in lib/inventory.ts that changes Product.quantity writes one
// row per affected product/piece here, in the same transaction as the
// quantity change (CREATED on initial stock, MANUAL_ADJUSTMENT from an
// edit, SALE/RETURN/VOID from the sale lifecycle). A SET container row
// never carries real stock (see the Product model's design note in
// 02-data-model.md), so it never gets a row here — only its pieces do.
model ProductStockMovement {
  id             String              @id @default(uuid())
  productId      String
  product        Product             @relation(fields: [productId], references: [id])
  quantityBefore Int
  quantityAfter  Int
  delta          Int
  reason         StockMovementReason
  saleId         String?
  sale           Sale?               @relation(fields: [saleId], references: [id])
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  createdAt      DateTime            @default(now())
}

model MovementLog {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id])
  action     MovementAction
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime       @default(now())
}
